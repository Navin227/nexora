# Environment Variables Template
# Copy this file to .env.local and fill in your values

# OTP Authentication (SMS service configuration)
# Leave empty for development mode (OTP shown in console)
# REACT_APP_SMS_PROVIDER=twilio
# REACT_APP_TWILIO_ACCOUNT_SID=your_twilio_account_sid
# REACT_APP_TWILIO_AUTH_TOKEN=your_twilio_auth_token
# REACT_APP_TWILIO_PHONE_NUMBER=+1234567890

# API Configuration (Optional - for future backend integration)
# REACT_APP_API_URL=http://localhost:3001
# REACT_APP_SOCKET_URL=http://localhost:3001

# Feature Flags
# REACT_APP_ENABLE_SOCKET_CHAT=true
# REACT_APP_ENABLE_ANALYTICS=false
