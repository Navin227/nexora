# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Google OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here
# Note: Client Secret should NEVER be exposed in frontend code
# It's only needed for backend token exchange if implementing server-side auth

# API Configuration (Optional - for future backend integration)
# REACT_APP_API_URL=http://localhost:3001
# REACT_APP_SOCKET_URL=http://localhost:3001

# Feature Flags
# REACT_APP_ENABLE_SOCKET_CHAT=true
# REACT_APP_ENABLE_ANALYTICS=false
